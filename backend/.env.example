# The URL of the Next.js frontend (used for CORS configuration)
FRONTEND_URL=http://localhost:3000

# Secret key used for signing JWT tokens. Must be changed in production!
SECRET_KEY=dev-secret-key-do-not-use-in-prod

# Set to True in production to ensure cookies are only sent over HTTPS
SESSION_COOKIE_SECURE=False

# Firebase service account credentials for Firestore (this app's only
# database -- see context_files/ARCHITECTURE.md). Base64-encode the service
# account JSON downloaded from Firebase Console > Project Settings > Service
# Accounts > Generate New Private Key, e.g.:
#   base64 -w0 service-account.json
# Required -- without it, db.init_app() logs a warning and leaves the
# Firestore client unset, so every DB-backed request will fail.
FIREBASE_SERVICE_ACCOUNT_B64=

# SendGrid API Key for automated onboarding emails (leave blank to mock locally)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@whatsappcrm.com
SENDGRID_FROM_NAME=WhatsApp CRM

# Meta WhatsApp Cloud API credentials.
# WHATSAPP_VERIFY_TOKEN is a string you choose yourself and enter in the Meta
# App Dashboard's webhook config; Meta echoes it back on the GET handshake.
# WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID come from the Meta App
# Dashboard's WhatsApp > API Setup page. Must be set to real values in any
# shared/production environment -- the defaults below only work for local dev.
WHATSAPP_VERIFY_TOKEN=dummy_verify_token
WHATSAPP_ACCESS_TOKEN=dummy_access_token
WHATSAPP_PHONE_NUMBER_ID=dummy_phone_id

# Fernet key used to AES-256-encrypt customer phone numbers at rest.
# The default below is a known, publicly-committed dev-only key -- generate a
# real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and set it here in any shared/staging/production environment. Never reuse the
# default outside local dev -- doing so makes phone number encryption meaningless.
ENCRYPTION_KEY=EQxvUe1pJ6zM6EOMQ_WgH95Of5VXXBLHFgiDNimuOwg=
